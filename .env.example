# Salin ke .env lalu ubah nilainya:  cp .env.example .env
APP_VERSION=latest
WEB_PORT=8080
# 127.0.0.1 = hanya bisa diakses dari server ini (wajib bila dipublikasikan lewat nginx/Cloudflare)
WEB_BIND=0.0.0.0
# false di server publik (menyembunyikan /api/docs)
DOCS_ENABLED=true
# kosong = frontend & API satu domain (normal). Isi bila frontend di domain lain, pisah koma
CORS_ORIGINS=

DB_USER=ecd
DB_PASSWORD=ganti-password-db
DB_NAME=ecd

# Wajib diganti di server: string acak panjang (mis. `openssl rand -hex 32`)
SECRET_KEY=ganti-dengan-secret-acak
TOKEN_HOURS=12

# Akun admin pertama (dibuat sekali saat tabel user kosong); ganti password setelah login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Folder pantau di host; isi: <HOST_INBOX_DIR>/<nama sumur>/*.las|*.csv|*.zip
HOST_INBOX_DIR=./data/inbox
WATCH_ENABLED=true
WATCH_INTERVAL_S=60

SOURCE_TZ=Asia/Jakarta
DISPLAY_TZ=Asia/Jakarta

# Opsional: narasi laporan otomatis (hanya ringkasan hasil yang dikirim)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
